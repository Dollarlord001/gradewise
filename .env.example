# Copy to .env.local for local development. Configure preview/staging and production
# independently in Vercel. Never put values from the server-only section in a NEXT_PUBLIC_ variable.
# Development: localhost URL, dedicated Supabase dev project, dedicated Redis database.
# Preview/staging: staging domain and isolated Supabase/Redis/storage resources.
# Production: production domain and production managed resources.

# Public browser configuration. Firebase web configuration and Supabase publishable key
# are public; PostgreSQL RLS remains the authorization boundary.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tutor-me-2fb22
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only secrets (never prefix these with NEXT_PUBLIC_). Production auth mutations
# fail closed unless both Upstash values are set. Do not use a service-role key for student requests.
FIREBASE_ADMIN_PROJECT_ID=tutor-me-2fb22
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ALOC_API_KEY=
SDASH_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Server-only object storage values (configure together for signed upload/download adapters).
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
